*.log
!samples/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code session files (keep launch.json, ignore session data)
.claude/projects/
